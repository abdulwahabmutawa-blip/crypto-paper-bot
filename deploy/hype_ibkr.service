[Unit]
Description=Hype trader on IBKR — one cycle (paper by port 4002; live needs 4001 + HYPE_IBKR_REAL=1)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tradebot
WorkingDirectory=/opt/tradebot/cloud-bot
EnvironmentFile=/etc/hype_ibkr.env
Environment=GIT_TERMINAL_PROMPT=0
Environment=HOME=/opt/tradebot
Environment="GIT_SSH_COMMAND=ssh -i /opt/tradebot/.ssh/id_ed25519 -o UserKnownHostsFile=/opt/tradebot/.ssh/known_hosts -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10"
ExecStart=/opt/tradebot/cloud-bot/deploy/hype_ibkr_runner.sh
TimeoutStartSec=600
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/tradebot

[Install]
WantedBy=multi-user.target
