[Unit]
Description=Lottery book — one cycle (real Binance spot, $20 hard cap)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tradebot
WorkingDirectory=/opt/tradebot/cloud-bot
# Keys live ONLY here, 600, owned by root — never in git, never in the unit
EnvironmentFile=/etc/lottery.env
# no TTY here: git must fail fast instead of waiting on a credential prompt
Environment=GIT_TERMINAL_PROMPT=0
# ProtectHome=true (below) hides /home from this service — deliberately.
# So the service's git credentials live under /opt/tradebot/.ssh (inside
# ReadWritePaths), and HOME points there too, keeping git's config lookups
# out of the hidden /home. First deployment shipped with the deploy key in
# /home/tradebot/.ssh and every push failed with Permission denied.
Environment=HOME=/opt/tradebot
# QUOTED as one assignment: systemd splits unquoted Environment= on spaces,
# so without quotes GIT_SSH_COMMAND became just "ssh" and every push kept
# failing host-key verification even after the key moved to /opt.
Environment="GIT_SSH_COMMAND=ssh -i /opt/tradebot/.ssh/id_ed25519 -o UserKnownHostsFile=/opt/tradebot/.ssh/known_hosts -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3"
ExecStart=/opt/tradebot/cloud-bot/deploy/lottery_runner.sh
# every network call inside the runner is timeout-bound (git 60s, API 20s),
# so this ceiling is slack, not a cliff a hung call can drag a SIGTERM onto
# mid-order (audit 08-15)
TimeoutStartSec=900

# a cycle must not outlive its window or two can overlap
Restart=no

# hardening: the bot needs network + its own repo, nothing else
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/tradebot

[Install]
WantedBy=multi-user.target
